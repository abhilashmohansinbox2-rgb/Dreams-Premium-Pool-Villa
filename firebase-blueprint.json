{
  "entities": {
    "UserBooking": {
      "title": "UserBooking",
      "description": "User specific villa direct bookings and inquiries",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID" },
        "bookingRef": { "type": "string" },
        "guestName": { "type": "string" },
        "guestEmail": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "totalAmount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "bookingRef", "guestName", "startDate", "endDate", "totalAmount"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" }
      },
      "required": ["userId", "email"]
    }
  },
  "firestore": {
    "/users/{userId}/bookings/{bookingId}": {
      "schema": "UserBooking",
      "description": "User isolated bookings collection"
    },
    "/users/{userId}/profile/{profileId}": {
      "schema": "UserProfile",
      "description": "User isolated profile collection"
    }
  }
}
